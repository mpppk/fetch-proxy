{
  "name": "fetch-proxy",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-file=/dev/null --env-interface CloudflareBindings --strict-vars=false",
    "check:types": "wrangler types --env-file=/dev/null --env-interface CloudflareBindings --strict-vars=false --check",
    "typecheck": "tsc --noEmit",
    "check": "biome check",
    "lint": "biome lint",
    "format": "biome format",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "check:deploy": "wrangler deploy --dry-run",
    "smoke": "bash scripts/smoke.sh",
    "smoke:preview": "bash scripts/smoke.sh https://fetch-proxy.niboshi.workers.dev"
  },
  "dependencies": {
    "defuddle": "^0.19.2",
    "hono": "^4.13.1",
    "linkedom": "^0.18.13"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@helpfeel/cosense-cli": "^1.10.1",
    "@types/node": "^26.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  }
}