{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fetch-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "browser": {
    "binding": "BROWSER"
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "fetch.nibo.sh/*",
      "zone_name": "nibo.sh"
    }
  ]
