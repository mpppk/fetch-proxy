{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fetch-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "browser": {
    "binding": "BROWSER"
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "fetch.nibo.sh/*",
      "zone_name": "nibo.sh"
    }
  ],
  // Workers Logs / Workers Traces をダッシュボードで確認できるようにする。
  // head_sampling_rate は 1 (100%)。個人利用の低トラフィックなので全件取得する。
  // traces は observability.enabled では有効にならないので明示する (2026-08 時点)。
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
  // "compatibility_flags": [
  //   "nodejs_compat"
  // ],
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
  // "kv_namespaces": [
  //   {
